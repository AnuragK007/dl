from tensorflow.keras.datasets import imdb
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding, LSTM, Dense
from tensorflow.keras.utils import pad_sequences

(x_train, y_train), (x_test, y_test) = imdb.load_data(num_words=5000)

x_train = pad_sequences(x_train, maxlen=100)
x_test = pad_sequences(x_test, maxlen=100)

model = Sequential([
    Embedding(5000, 32),
    LSTM(32),
    Dense(1, activation="sigmoid")
])

model.compile(optimizer="adam",
              loss="binary_crossentropy",
              metrics=["accuracy"])

model.fit(x_train, y_train, epochs=3, batch_size=64)

loss, accuracy = model.evaluate(x_test, y_test)
print("Test Accuracy:", accuracy)

review = "This movie was excellent and amazing"
word_index = imdb.get_word_index()

seq = [word_index.get(w, -1) + 3 for w in review.lower().split()]
seq = pad_sequences([[x if 3 <= x < 5000 else 2 for x in seq]], maxlen=100)

pred = model.predict(seq)

print("Positive" if pred[0][0] > 0.5 else "Negative")
